{
  "manifest_version": 3,
  "name": "B站考古工具 · 时间胶囊",
  "version": "2.4",
  "description": "B站搜索增强，支持拖拽时间轴、分区筛选、排序和随机跳跃考古。",
  "content_scripts": [
    {
      "matches": ["*://search.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["presets.json"],
      "matches": ["*://search.bilibili.com/*"]
    }
  ]
}
